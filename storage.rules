rules_version = '2';
// Deploy: Firebase Console → Storage → Rules, or `firebase deploy --only storage`
service firebase.storage {
  match /b/{bucket}/o {
    // Listing images (landlord flow): listings/{listingId}/{index}
    match /listings/{listingId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Profile pictures: users/{uid}/... — only that user may write
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
