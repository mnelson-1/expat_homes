rules_version = '2';
// ExpatHomes Firestore rules — auth + listings.
// Deploy: firebase deploy --only firestore:rules (from project root with firebase.json).
// Storage rules are separate: Firebase Console → Storage → Rules (see docs/FIREBASE_SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Users: only the signed-in user can read/write their own profile.
    // Note: we deliberately DO NOT call isSuperAdmin() here to avoid
    // circular reads on the same document during rule evaluation.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings: landlord can create and read/update their own; any signed-in user can read published.
    match /listings/{listingId} {
      allow read: if isSignedIn() &&
        (resource == null ||
         resource.data.landlordId == request.auth.uid ||
         resource.data.status == 'published' ||
         isSuperAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.landlordId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isSuperAdmin());
    }

    // Edit requests: landlord creates; admin reads/updates status.
    match /edit_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.landlordId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin();
    }

    // Listing revisions: landlord creates (after edit request approved); admin reads/updates.
    match /listing_revisions/{revisionId} {
      allow read: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.landlordId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin();
    }
  }
}
