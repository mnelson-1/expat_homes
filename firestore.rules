rules_version = '2';
// ExpatHomes Firestore rules — auth + listings.
// Deploy: firebase deploy --only firestore:rules (from project root with firebase.json).
// Storage rules are separate: Firebase Console → Storage → Rules (see docs/FIREBASE_SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: only the signed-in user can read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Listings: landlord can create and read/update their own; any signed-in user can read published.
    match /listings/{listingId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.landlordId == request.auth.uid || resource.data.status == 'published');
      allow create: if request.auth != null && request.resource.data.landlordId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.landlordId == request.auth.uid;
    }
  }
}
