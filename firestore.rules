rules_version = '2';
// ExpatHomes Firestore rules — auth + listings.
// Deploy: firebase deploy --only firestore:rules (from project root with firebase.json).
// Storage rules are separate: Firebase Console → Storage → Rules (see docs/FIREBASE_SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Users: any signed-in user can read profiles (needed for message thread
    // avatars, etc.). Writes are limited to the document owner.
    // Note: we deliberately DO NOT call isSuperAdmin() on this match to avoid
    // circular reads during rule evaluation.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings: any signed-in user can read (agents need access to assigned listings,
    // expats to published ones). Writes restricted to owner or admin.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.landlordId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isSuperAdmin());
    }

    // Edit requests: landlord creates; admin reads/updates status.
    match /edit_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.landlordId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin();
    }

    // Listing revisions: landlord creates (after edit request approved); admin reads/updates.
    match /listing_revisions/{revisionId} {
      allow read: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.landlordId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin();
    }

    // Licensed agents: anyone can read (needed for agent ID validation at sign-up
    // before the user is authenticated). Writes allowed for signed-in users (seeding + registration link).
    match /licensed_agents/{agentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Listing assignments: any signed-in user can read (needed for representative
    // resolution). Landlord can create; landlord/agent/admin can update.
    match /listing_assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Conversations: any signed-in user can read their own and create new ones.
    match /conversations/{conversationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Messages: any signed-in user can read and write messages.
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Commission slips: agent creates; both agent and landlord can read/update.
    match /commission_slips/{slipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Community posts: any signed-in user can read; author can create/update/delete.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Post comments: any signed-in user can read and create; author can update.
    match /post_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Bowls: any signed-in user can read; writes for seeding.
    match /bowls/{bowlId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Bowl membership: any signed-in user can read, join, or leave.
    match /bowl_members/{memberId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn();
    }
  }
}
